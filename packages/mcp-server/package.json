{
  "name": "@sbtools/mcp-server",
  "version": "0.10.0",
  "description": "MCP server exposing all Migration Studio tools to Claude, Cursor, and VS Code.",
  "type": "module",
  "bin": {
    "sbtools-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/supabase-tools.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@sbtools/plugin-migration-studio": "^0.10.0",
    "@sbtools/sdk": "^0.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
