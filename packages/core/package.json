{
  "name": "@sbtools/core",
  "version": "0.5.0",
  "description": "Core CLI orchestrator for supabase-tools — config, plugins, snapshot pipeline.",
  "type": "module",
  "bin": {
    "sbt": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "docker",
    "docker-compose.db.yml",
    "docker-compose.api-docs.yml",
    "nginx-docs.conf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/supabase-tools.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "supabase",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sbtools/sdk": "^0.5.0",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
