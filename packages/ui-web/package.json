{
  "name": "@sbtools/ui-web",
  "version": "0.6.1",
  "description": "Shared React UI renderer package for supabase-tools web pages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/supabase-tools.git",
    "directory": "packages/ui-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:tokens": "tsx scripts/generate-shared-tokens.ts",
    "dev": "npm run generate:tokens && vite",
    "build": "npm run generate:tokens && tsc --project tsconfig.json && vite build",
    "build:dashboard": "vite build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lint": "^6.9.4",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.14",
    "lucide-react": "^0.474.0",
    "mermaid": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.7"
  }
}
