{
  "name": "@sbtools/plugin-migration-studio",
  "version": "0.6.1",
  "description": "Migration authoring studio for supabase-tools — create and apply migrations from a browser UI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazokhan/supabase-tools.git",
    "directory": "packages/plugin-migration-studio"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "supabase",
    "tools",
    "migration",
    "studio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sbtools/sdk": "^0.6.0",
    "@supabase/pg-parser": "^0.1.3",
    "pg": "^8.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
