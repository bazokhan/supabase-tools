{
  "name": "supabase-tools",
  "version": "0.1.0",
  "description": "Portable toolkit for local Supabase development: Docker services, migrations, snapshots, ERD, tests, and docs.",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "sbt": "node packages/core/dist/cli.js",
    "dev": "tsx packages/core/src/cli.ts",
    "start": "npm run sbt -- start",
    "stop": "npm run sbt -- stop",
    "restart": "npm run sbt -- restart",
    "status": "npm run sbt -- status",
    "migrate": "npm run sbt -- migrate",
    "snapshot": "npm run sbt -- snapshot",
    "generate-types": "npm run sbt -- generate-types",
    "generate-erd": "npm run sbt -- generate-erd",
    "generate-atlas": "npm run sbt -- generate-atlas",
    "test:db": "npm run sbt -- test",
    "test:db:mem": "npm run sbt -- test --mem",
    "docs": "npm run sbt -- docs",
    "help": "npm run sbt -- help",
    "build": "npm run build -w packages/sdk && npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "release": "npm run build && changeset publish",
    "test": "vitest run --config packages/core/vitest.config.ts",
    "test:watch": "vitest --config packages/core/vitest.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18",
    "vitepress": "^1.0.0"
  }
}
